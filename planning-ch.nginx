# Zones : doivent être dans le contexte http{} (ok si ce fichier
# est inclus depuis nginx.conf via sites-enabled).
#
# Node : 127.0.0.1:3000 (ecosystem.config.cjs). Pas 3344.
#
#   sudo cp planning-ch.nginx /etc/nginx/sites-available/planning-ch
#   sudo ln -sf /etc/nginx/sites-available/planning-ch /etc/nginx/sites-enabled/planning-ch
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d che.pelsy.net -d www.che.pelsy.net

limit_req_zone $binary_remote_addr zone=planning_ch_req:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=planning_ch_login:10m rate=10r/m;
limit_conn_zone $binary_remote_addr zone=planning_ch_conn:10m;
limit_req_status 429;

server {
	listen 80 default_server;
	listen [::]:80 default_server;
	server_name _;
	return 444;
}

server {
	listen 80;
	listen [::]:80;
	server_name che.pelsy.net www.che.pelsy.net;

	server_tokens off;
	client_max_body_size 512k;
	client_body_timeout 10s;
	client_header_timeout 10s;
	send_timeout 10s;
	ignore_invalid_headers on;

	add_header X-Content-Type-Options nosniff always;
	add_header X-Frame-Options DENY always;
	add_header Referrer-Policy strict-origin-when-cross-origin always;
	add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

	if ($request_method !~ ^(GET|HEAD|POST)$) {
		return 405;
	}

	# Avant location ~ /\. sinon Certbot (/.well-known) est refusé.
	location ^~ /.well-known/acme-challenge/ {
		default_type "text/plain";
		root /var/www/html;
	}

	location ~ /\. {
		deny all;
	}

	location /login {
		limit_req zone=planning_ch_login burst=8 nodelay;
		limit_conn planning_ch_conn 20;

		proxy_pass http://127.0.0.1:3000;
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $host;
		proxy_set_header Connection "";
		proxy_read_timeout 60s;
	}

	location / {
		limit_req zone=planning_ch_req burst=80 nodelay;
		limit_conn planning_ch_conn 20;

		proxy_pass http://127.0.0.1:3000;
		proxy_http_version 1.1;
		proxy_set_header Host $host;
		proxy_set_header X-Real-IP $remote_addr;
		proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto $scheme;
		proxy_set_header X-Forwarded-Host $host;
		proxy_set_header Connection "";
		proxy_read_timeout 60s;
	}
}
